{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/lib/supabase/browser": ["./lib/supabase.ts"],
      "@/lib/supabase/server": ["./lib/server-disabled.ts"],
      "@/lib/supabase/admin": ["./lib/server-disabled.ts"],
      "@/lib/env": ["./lib/env.ts"],
      "@/*": ["../*"]
    }
  },
  "include": ["next-env.d.ts", "../types/**/*.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}
